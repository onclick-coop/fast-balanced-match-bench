{
  "name": "fast-balanced-match-bench",
  "version": "1.0.0",
  "description": "Benchmarks @onclick/fast-balanced-match against balanced-match",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "scripts": {
    "bench": "node src/bench.ts",
    "check": "vp check",
    "typecheck": "tsc",
    "lint": "vp lint --deny-warnings --report-unused-disable-directives",
    "chart": "node scripts/chart.ts"
  },
  "dependencies": {
    "@onclick/fast-balanced-match": "link:../fast-balanced-match",
    "balanced-match": "^5.0.0"
  },
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
